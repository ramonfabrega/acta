{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acta",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The Worker serves the page too. Cloudflare Access guards the hostname;
  // the Worker verifies the Access JWT (CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD).
  "routes": [{ "pattern": "acta.ramonfabrega.com", "custom_domain": true }],

  // One Scribe per meeting: agent socket, utterances, paragraphs, the book.
  "durable_objects": {
    "bindings": [{ "name": "SCRIBE", "class_name": "Scribe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scribe"] }],

  // Our copy of everything RealtimeKit deletes after seven days.
  "r2_buckets": [{ "binding": "MEETINGS", "bucket_name": "acta-meetings" }],

  // Batch re-transcription (Whisper) and small models; nova-3 live is
  // RealtimeKit's own call and bills to this account as Workers AI neurons.
  "ai": { "binding": "AI" },

  "vars": {
    // Non-secret identifiers. Secrets go through `wrangler secret put`:
    //   RTK_API_TOKEN   Cloudflare API token with Realtime admin scope
    //   ACTA_TOKEN      the one operator bearer: CLI, brain, events socket
    // Webhooks need no secret: RealtimeKit signs them with a published RSA key.
    "RTK_APP_ID": "276bc18e-e03f-4d6e-909e-898691b379ef",
    "CF_ACCOUNT_ID": "2deff21d2e459d1c5997c4fe57a208e2",
    "PUBLIC_HOST": "acta.ramonfabrega.com",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  }
}
